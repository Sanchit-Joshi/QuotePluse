# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. In Docker Compose this points at the "db" service;
# for local (non-Docker) development, point at your local Postgres instance.
DATABASE_URL="postgresql://quotation:quotation_dev_password@localhost:5432/quotation?schema=public"

# development | production | test
NODE_ENV="development"

# Base URL the server uses to reach itself (Playwright navigates here to
# render the PDF/print pages). In Docker Compose this stays localhost since
# Playwright runs inside the same container as the Next.js server.
APP_URL="http://localhost:3000"

# Local filesystem paths used for generated PDFs and uploaded logo/signature files.
# Cloud-ready: swap the storage repository implementation to use S3-compatible
# storage without changing callers (see docs/backend-architecture.md).
PDF_STORAGE_DIR="./storage/pdfs"
UPLOAD_STORAGE_DIR="./storage/uploads"
