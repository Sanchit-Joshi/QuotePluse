# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. In Docker Compose this points at the "db" service;
# for local (non-Docker) development, point at your local Postgres instance.
DATABASE_URL="postgresql://quotation:quotation_dev_password@localhost:5432/quotation?schema=public"

# development | production | test
NODE_ENV="development"

# Base URL the server uses to reach itself (Playwright navigates here to
# render the PDF/print pages). In Docker Compose this stays localhost since
# Playwright runs inside the same container as the Next.js server.
APP_URL="http://localhost:3000"

# Local filesystem path used for generated PDFs.
PDF_STORAGE_DIR="./storage/pdfs"

# Supabase Storage — logo/signature uploads (server-only secret key, never
# exposed to the client; bucket must exist and allow public read so the PDF
# renderer and browser can load the image URL directly). See ADR-010.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_UPLOADS_BUCKET="uploads"
